# Application
APP_ENV=production
APP_DEFAULT_LANGUAGE=en
APP_TIMEZONE=Europe/Budapest
APP_LOG_LEVEL=INFO

# Database
# Local Docker Compose example:
DATABASE_URL=postgresql+psycopg://realestate:change-me@db:5432/realestate

# Data collection
HTTP_TIMEOUT_SECONDS=20
SOURCE_STALE_HOURS=36
SELF_HEAL_ENABLED=true
MARKET_NOTIFY_CHANGE_PERCENT=1.0

# Granular KSH Ingatlanadattár refresh. The quarterly KSH series still refreshes daily.
KSH_LOCAL_REFRESH_HOURS=168

# Experimental Duna House factual asking-market observer.
# The collector also has a built-in policy guard and a dated manual review boundary.
DH_ENABLED=true
DH_MAX_LISTINGS_PER_RUN=250
DH_REQUEST_DELAY_SECONDS=0.20
DH_MIN_AGGREGATE_SAMPLE=12
# Consecutive eligible-sitemap absences before an observed listing becomes inactive.
# Reappearance resets this state. Disappearance is never treated as proof of sale.
DH_INACTIVE_AFTER_MISSES=2
DH_POLICY_REVIEW_MAX_AGE_DAYS=90

# Notifications are optional. Configure any combination of these channels.
NOTIFY_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# Optional protection for operational endpoints. If set, send it as X-Admin-Key.
ADMIN_KEY=
